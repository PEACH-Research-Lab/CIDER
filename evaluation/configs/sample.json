{
  "ratings_path": "dataset/original/user_ratings.jsonl",
  "scenarios_path": "dataset/original/scenarios.jsonl",
  "output_root": "outputs/eval",
  "batch_id": "demo",
  "max_workers": 2,
  "prompt_variants": ["v0", "v1", "v2"],
  "dataset": {
    "seed": 42,
    "n_icl_examples": 4,
    "icl_reference_k": 6,
    "align_to_k": true,
    "min_scenarios": 8,
    "sample_frac": 0.01
  },
  "prediction_timeout_seconds": 120.0,
  "prediction_temperature": 0.0,
  "prediction_seed": 42,
  "prediction_max_retries": 3,
  "save_interval": 1, 
  "return_usage": true,
  "models": [
    {
      "model": "qwen/qwen3.5-9b",
      "setups": ["Baseline", "H", "HL", "HC"],
      "provider": "openrouter",
      "base_url": "https://openrouter.ai/api/v1",
      "api_key_env": "OPENROUTER_API_KEY",
      "reasoning": {
        "enabled": false
      }
    }
  ]
}
